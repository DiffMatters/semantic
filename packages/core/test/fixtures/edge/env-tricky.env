# .env syntax edge cases. Every line here is VALID per the dotenv grammar
# (as implemented by the `dotenv` npm package and docker compose), but trips
# naive "split on first =" parsers.

# --- quoting --------------------------------------------------------------
UNQUOTED=plain value with spaces
UNQUOTED_TRAILING_WS=trailing spaces
DOUBLE="double quoted"
SINGLE='single quoted'
BACKTICK=`backtick quoted`
EMPTY=
EMPTY_DOUBLE=""
EMPTY_SINGLE=''
QUOTE_INSIDE_SINGLE='He said "hi"'
QUOTE_INSIDE_DOUBLE="It's fine"
ESCAPED_DOUBLE="say \"hello\""
MISMATCHED_QUOTES='abc"
ONLY_OPEN_QUOTE_IN_VALUE=5'oclock
HASH_IN_DOUBLE="value # not a comment"
HASH_IN_SINGLE='value # not a comment'
HASH_UNQUOTED_NO_SPACE=value#not-a-comment
HASH_UNQUOTED_SPACE=value # this IS a comment
INLINE_COMMENT_AFTER_QUOTE="quoted" # comment

# --- escapes and multiline ---------------------------------------------
NEWLINE_ESCAPE="line1\nline2"
NEWLINE_ESCAPE_SINGLE='line1\nline2'
TAB_ESCAPE="a\tb"
MULTILINE_DOUBLE="first line
second line
third line"
MULTILINE_SINGLE='first
second'
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIBOgIBAAJBAKj34GkxFhD90vcNLYLInFEX6Ppy1tPf9Cnzj4p4WGeKLs1Pt8Qu
KUpRKfFLfRYC9AIKjbJTWit+CqvjWYzvQwECAwEAAQ==
-----END RSA PRIVATE KEY-----"

# --- keys ----------------------------------------------------------------
export EXPORTED=1
  INDENTED=2
lowercase_key=3
MixedCase_Key=4
KEY.WITH.DOTS=5
KEY-WITH-DASHES=6
_LEADING_UNDERSCORE=7
KEY123=8
SPACES_AROUND = 9
SPACES_BEFORE_EQ =10
SPACES_AFTER_EQ= 11

# --- nesting separators ------------------------------------------------
APP__NAME=nested-one-level
APP__DB__HOST=nested-two-levels
APP__DB__PORT=5432
APP__TAGS__0=first
APP__TAGS__1=second
APP__TAGS__2=third
LEADING__SEP=leading separator yields empty segment
TRAILING__=trailing separator yields empty segment
TRIPLE___UNDERSCORE=ambiguous: "TRIPLE_" + "UNDERSCORE" or "TRIPLE" + "_UNDERSCORE"
SINGLE_UNDERSCORE_IS_NOT_NESTING=true

# --- values containing special characters -------------------------------
HAS_EQUALS=a=b=c
URL=postgres://user:p%40ss@host:5432/db?sslmode=require&pool=5
JSON_VALUE={"nested":{"key":[1,2,3]},"flag":true}
YAML_LOOKING=key: value
COMMA_LIST=a,b,c
COMMA_LIST_SPACES=a, b, c
COMMA_LIST_TRAILING=a,b,c,
BOOL_TRUE=true
BOOL_TRUE_CAPS=TRUE
BOOL_YES=yes
BOOL_ONE=1
NUMBER=42
NUMBER_FLOAT=3.14
NUMBER_EXP=1e3
NUMBER_LEADING_ZERO=007
NUMBER_PLUS=+5
NUMBER_HEX=0xFF
LOOKS_NULL=null
TILDE=~
UNICODE=Grüße 世界 🚀
INTERPOLATION=${APP__NAME}/suffix
INTERPOLATION_DEFAULT=${MISSING:-fallback}
DOLLAR_LITERAL='$HOME'
DOLLAR_ESCAPED="\$HOME"
WINDOWS_PATH=C:\Users\me\app
LONG_VALUE=Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.

# --- duplicates (last one wins in dotenv; tool should warn) -------------
DUPLICATE=first
DUPLICATE=second
