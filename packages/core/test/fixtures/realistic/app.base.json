    "sentry": { "dsn": "https://abc123@o0.ingest.sentry.io/0", "sample_rate": 0.25 }
  },
  "maintenance_window": "",
  "tags": [],
  "metadata": {},
  "legacy.setting": "dotted-key-value",
  "allowed_ips": ["10.0.0.0/8", "192.168.1.0/24"],
  "scale": {
