{
  "app_name": "orders-service",
  "version": "1.10",
  "environment": "staging",
  "release_date": "2024-01-15",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": false,
    "read_timeout_ms": 30000,
    "max_body_bytes": 10485760,
    "cors": {
      "enabled": true,
      "allowed_origins": ["https://app.example.com", "https://admin.example.com"],
      "allowed_methods": ["GET", "POST", "PUT", "DELETE"]
    }
  },
  "database": {
    "driver": "postgres",
    "host": "db.staging.internal",
    "port": 5432,
    "name": "orders",
    "user": "orders_rw",
    "password": "s3cr3t-staging-pw",
    "ssl_mode": "require",
    "pool": { "min": 2, "max": 10, "idle_timeout_s": 300 }
  },
  "redis": {
    "url": "redis://cache.staging.internal:6379/0",
    "ttl_s": 600
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "sinks": ["stdout", "file"],
    "file": { "path": "/var/log/orders.log", "max_size_mb": 100, "rotate": 5 }
