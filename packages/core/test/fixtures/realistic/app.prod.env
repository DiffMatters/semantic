# Production .env for orders-service.
# Nesting uses "__" (double underscore). Flat keys like DEBUG have no
# counterpart in the structured configs and must be reported as extra.
# All values are strings: loose mode should treat 8080 as 8080 and true as true.
# Expected: equal to app.prod.yaml in loose mode with --env-separator __,
# apart from the "extra" block at the bottom and the keyed arrays (services).

APP_NAME=orders-service
VERSION=1.11.0
ENVIRONMENT=production
RELEASE_DATE=2024-03-01

export SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__TLS=true
SERVER__READ_TIMEOUT_MS=15000
SERVER__MAX_BODY_BYTES=10485760
SERVER__CORS__ENABLED=true
SERVER__CORS__ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
SERVER__CORS__ALLOWED_METHODS="GET,POST,PUT,DELETE"
SERVER__CORS__MAX_AGE_S=86400

DATABASE__DRIVER=postgres
DATABASE__HOST=db-primary.prod.internal
DATABASE__PORT=5432
DATABASE__NAME=orders
DATABASE__USER=orders_rw
DATABASE__PASSWORD='Pr0d-P@ssw0rd!'   # single quotes: no escapes; '#' after whitespace starts a comment
DATABASE__SSL_MODE=require
DATABASE__POOL__MIN=2
DATABASE__POOL__MAX=50
DATABASE__POOL__IDLE_TIMEOUT_S=300
DATABASE__READ_REPLICAS=db-replica-1.prod.internal,db-replica-2.prod.internal

REDIS__URL=rediss://cache.prod.internal:6380/0

LOGGING__LEVEL=info
LOGGING__FORMAT=json
LOGGING__SINKS=stdout

FEATURES__NEW_CHECKOUT=false
FEATURES__DARK_MODE=false
FEATURES__AI_RECS=true

RATE_LIMITS__DEFAULT__REQUESTS=100
RATE_LIMITS__DEFAULT__WINDOW_S=60
RATE_LIMITS__PER_IP__REQUESTS=1000
RATE_LIMITS__PER_IP__WINDOW_S=3600

# Arrays of objects cannot be expressed natively in .env; indexed keys are one convention.
SERVICES__0__NAME=inventory
SERVICES__0__URL=https://inventory.prod.internal
SERVICES__0__TIMEOUT_MS=2000
SERVICES__0__RETRIES=1
SERVICES__1__NAME=payments
SERVICES__1__URL=https://payments.prod.internal
SERVICES__1__TIMEOUT_MS=8000
SERVICES__1__RETRIES=3
SERVICES__2__NAME=search
SERVICES__2__URL=https://search.prod.internal
SERVICES__2__TIMEOUT_MS=1500
SERVICES__2__RETRIES=2

INTEGRATIONS__STRIPE__API_KEY=sk-live-FAKE-KEY-FOR-TESTS-ONLY
INTEGRATIONS__STRIPE__WEBHOOK_SECRET=whsec_yyyyyyyyyyyyyyyy
INTEGRATIONS__SENTRY__DSN="https://abc123@o0.ingest.sentry.io/0"
INTEGRATIONS__SENTRY__SAMPLE_RATE=0.05

MAINTENANCE_WINDOW=
ALLOWED_IPS=10.0.0.0/8

SCALE__CPU_LIMIT=1.5
SCALE__MEMORY_MB=512
SCALE__MIN_REPLICAS=3
SCALE__MAX_REPLICAS=20
SCALE__SCALE_FACTOR=1000
SCALE__AUTOSCALE=true

GREETING="Hello, 世界 — ünïcödé ✓"
FILE_MODE=0755
ZIP_CODE=02134
NOTES="line one\nline two\n"

# Flat keys with no structured counterpart (should show as "extra"):
DEBUG=false
NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://orders_rw:Pr0d-P%40ssw0rd%21@db-primary.prod.internal:5432/orders?sslmode=require
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCyEXAMPLEKEY
JWT_SECRET=eyJhbGciOiJIUzI1NiJ9.e30.ZRrHA1JJJW8opsbCGfG_HACGpVUMN_a9IV7pAx_Zmeo
