# Pair with collisions.a.json using --env-separator __ in loose mode.
# Exercises: literal dotted key vs nested path, key-style folding collisions,
# index-key objects vs arrays, keys that need quoting in path output,
# and prototype-pollution bait keys that must be treated as plain data.
A__B=nested a -> b
A.B=literal dotted key a.b
MAX_RETRIES=6
TIMEOUT=60
ITEMS__0=zero
ITEMS__1=one
ITEMS__2=two
SPARSE__0=zero
SPARSE__2=two
NOT_AN_ARRAY__0=zero
NOT_AN_ARRAY__1=one
NOT_AN_ARRAY__NAME=x
ÜNÏCÖDÉ=unicode key
__PROTO__=prototype pollution bait
CONSTRUCTOR=also bait
# A__B exists above as an object path; this scalar at A collides with it (KEY_COLLISION):
A=scalar at the parent path
